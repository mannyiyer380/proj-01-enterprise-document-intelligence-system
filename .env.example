# Copy this file to .env and fill in the values. Never commit .env.

# --- Provider API keys ---
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
HF_TOKEN=

# --- Model providers ---
# openai | groq | google
LLM_PROVIDER=openai
# Optional: use a different provider for chat (defaults to LLM_PROVIDER)
CHAT_LLM_PROVIDER=
# huggingface | google
EMBEDDING_PROVIDER=huggingface

# --- Auth ---
APP_ENV=development
# sqlite (built-in accounts) | local (no login) | jwt
AUTH_MODE=sqlite
# Only needed when AUTH_MODE=jwt. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- Optional overrides (defaults shown in app/config/config.py) ---
# DATASET_DIR=./documents
# OUTPUT_DIR=./output
# CHUNK_SIZE=
# CHUNK_OVERLAP=
# MAX_UPLOAD_MB=15
